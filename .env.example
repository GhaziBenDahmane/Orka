DOCKYARD_LISTEN_ADDR=:8080
DOCKYARD_DATABASE_URL=postgres://dockyard:dockyard@localhost:5432/dockyard?sslmode=disable
DOCKYARD_REQUIRE_DATABASE_TLS=false
DOCKYARD_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Dedicated operator credential for the global Prometheus endpoint. Use
# DOCKYARD_METRICS_TOKEN_FILE with a mode-0600 secret file in production.
DOCKYARD_METRICS_TOKEN=replace-with-at-least-32-random-bytes
DOCKYARD_DOCKER_BIN=docker
DOCKYARD_WORKER_CONCURRENCY=2
DOCKYARD_SESSION_TTL=24h
DOCKYARD_TRAEFIK_NETWORK=dockyard-public
DOCKYARD_PUBLIC_URL=http://localhost:8080
DOCKYARD_BACKUP_DIRECTORY=/var/lib/dockyard/backups
DOCKYARD_REQUIRE_REMOTE_BACKUPS=false
# Optional absolute directory containing trusted executable database drivers.
DOCKYARD_DATABASE_DRIVER_DIRECTORY=
# Optional OTLP/gRPC trace export. Leave empty to keep tracing local/no-op.
DOCKYARD_OTEL_EXPORTER_OTLP_ENDPOINT=
DOCKYARD_OTEL_EXPORTER_OTLP_INSECURE=false
DOCKYARD_OTEL_SERVICE_NAME=dockyard
# Optional remote-agent CA. Prefer Docker secret files in production.
DOCKYARD_AGENT_CA_CERT_FILE=
DOCKYARD_AGENT_CA_KEY_FILE=
DOCKYARD_AGENT_CERTIFICATE_TTL=168h
DOCKYARD_AGENT_LISTEN_ADDR=
DOCKYARD_AGENT_SERVER_CERT_FILE=
DOCKYARD_AGENT_SERVER_KEY_FILE=
